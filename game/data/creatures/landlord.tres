[resource]
script = ExtResource("Script_3")
idname = &"CREATURE_LANDLORD"
type_name = "Landlord"
encounter_name = "Landlord"
alignment = &"moderate"
gender = &"male_bias"
age = SubResource("Sub_1")
juice = SubResource("Sub_2")
money = SubResource("Sub_3")
infiltration = SubResource("Sub_4")
attribute_points = SubResource("Sub_5")
attributes = {&"intelligence": SubResource("Sub_6"), &"wisdom": SubResource("Sub_7")}
skills = {&"business": SubResource("Sub_8")}
