number_clips = SubResource("Sub_10")

[resource]
script = ExtResource("Script_3")
idname = &"CREATURE_POLITICIAN"
type_name = "Politician"
encounter_name = ""
alignment = &"conservative"
gender = &"male_bias"
age = SubResource("Sub_1")
juice = SubResource("Sub_2")
money = SubResource("Sub_3")
infiltration = SubResource("Sub_4")
attribute_points = SubResource("Sub_5")
attributes = {&"wisdom": SubResource("Sub_6")}
skills = {&"law": SubResource("Sub_7"), &"persuasion": SubResource("Sub_8")}
armortypes = Array[StringName]([&"ARMOR_EXPENSIVESUIT"])
weapons = Array[Resource]([SubResource("Sub_11")])
