min = 40
max = 80

[sub_resource type="Resource" id="Sub_4"]
script = ExtResource("Script_1")
min = 80
max = 95

[sub_resource type="Resource" id="Sub_5"]
script = ExtResource("Script_1")
min = 40
max = 40

[sub_resource type="Resource" id="Sub_6"]
script = ExtResource("Script_1")
min = 6
max = 10

[sub_resource type="Resource" id="Sub_7"]
script = ExtResource("Script_1")
min = 1
max = 7

[sub_resource type="Resource" id="Sub_8"]
