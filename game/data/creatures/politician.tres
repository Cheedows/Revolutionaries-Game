[gd_resource type="Resource" script_class="CreatureType" load_steps=15 format=3]

[ext_resource type="Script" path="res://data/schema/interval.gd" id="Script_1"]
[ext_resource type="Script" path="res://data/schema/creature_weapons.gd" id="Script_2"]
[ext_resource type="Script" path="res://data/schema/creature_type.gd" id="Script_3"]

[sub_resource type="Resource" id="Sub_1"]
script = ExtResource("Script_1")
min = 35
max = 59

[sub_resource type="Resource" id="Sub_2"]
script = ExtResource("Script_1")
min = 400
max = 800

[sub_resource type="Resource" id="Sub_3"]
