[resource]
script = ExtResource("Script_1")
idname = &"AUGMENTATION_HARDENED_SKIN"
name = "Hardened Skin"
description = "Human skin has far outlived its usefulness in an evolutionary aspect, not able to stop even the smallest of bullets. Therefore, we should remove the skin of a Liberal, and encase them in a metal shell!"
type = &"skin"
attribute = &"health"
effect = 3
cost = 0
difficulty = 5
min_age = 0
max_age = 999
