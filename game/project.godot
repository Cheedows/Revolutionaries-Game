; Revolutionaries — Godot 4.6 project.
; Engine configuration only. Game-facing naming lives in branding.gd; see
; docs/port/ARCHITECTURE.md §6 before changing config/name here.

config_version=5

[application]

config/name="Revolutionaries"
config/description="A modernized port of Liberal Crime Squad (GPL-2.0-or-later)."
config/version="0.1.0-port"
run/main_scene="res://ui/screens/main.tscn"
; Android's back button closes the game unless the game says otherwise, and a
; player who has the paper open and presses back means "shut the paper". See
; BaseLayout.step_back().
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Forward Plus")

[display]

; The screen is laid out with anchors and expand flags rather than fixed
; positions, so it survives being resized; the scale mode keeps it legible on
; a large display without redrawing everything.
; The base viewport is portrait, and this is the whole trick. With
; stretch/aspect "expand" the scale is min(screen.x/base.x, screen.y/base.y)
; and the viewport is the screen divided by it, so whichever axis is tighter
; against the base decides what the layout is handed.
;
; A base of 400x800 gives a 1080x2400 phone a viewport of 400x888 at 2.7x —
; narrow, which is what ui/theme/metrics.gd calls a phone, and large enough to
; read. A base of 1280x800 gave the same phone 1280x2844 at 0.84x: the desktop
; layout, shrunk to unreadability, in a viewport three times taller than it
; had anything to put in. That is what this project shipped.
;
; Desktop is untouched, because any window wider than 1:2 is bound by its
; height either way: 1920x1080 gives 1422x800 under both, and 1280x800 gives
; 1280x800 under both. The window_*_override pair is what keeps the desktop
; window opening at 1280x800 rather than at the base size.
window/size/viewport_width=400
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

; Portrait. The layout is built for a narrow column — one scroller, a stack of
; panels, a row of buttons along the bottom — and a phone turned sideways gets
; the desktop's two-column layout at finger size, which fits but is unreadable.
; Desktop is unaffected: handheld/ only applies to Android and iOS.
;
; The number matters. This setting is an int in Godot 4 —
; DisplayServer.SCREEN_PORTRAIT is 1 — and the Android exporter casts whatever
; it finds to int on the way into the manifest. A string here does not fail:
; it casts to 0, which is SCREEN_LANDSCAPE, and every build comes out locked
; sideways with nothing to say it went wrong. This project shipped for months
; reading "sensor" and meaning landscape. tools/android/check_orientation.py
; reads the exported APK back and fails the build if it ever happens again.
window/handheld/orientation=1

[input_devices]

; The floor plan is walked by tapping a square next to the squad, which
; arrives as a click. Stated rather than left to the default, because the site
; map depends on it.
pointing/emulate_mouse_from_touch=true

[autoload]

Branding="*res://branding.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[rendering]

renderer/rendering_method="forward_plus"
; The game draws nothing but Controls, so on a phone it asks for the renderer
; every phone has rather than the one the newest ones have.
renderer/rendering_method.mobile="gl_compatibility"

; Android will not export a project that does not import textures in a format
; Android can read, and refuses without saying so — this is the empty list of
; configuration errors the export prints when it is off. The game has no
; textures at all, so it costs nothing and changes nothing on the desktop.
textures/vram_compression/import_etc2_astc=true
